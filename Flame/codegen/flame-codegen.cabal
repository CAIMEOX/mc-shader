cabal-version: 3.0
name: flame-codegen
version: 0.1.0.0
build-type: Simple

common defaults
  default-language: GHC2021
  ghc-options: -Wall -O1
  build-depends: base >=4.18 && <5

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Flame.Domain
    Flame.Pack
    Flame.Pipeline
    Flame.Program
    Flame.Protocol
  other-modules:
    Flame.DataPack
    Flame.Json
  build-depends: bytestring, directory, filepath

executable flame-codegen
  import: defaults
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: flame-codegen

test-suite semantics
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: flame-codegen
