#!/usr/bin/env python3
"""Build LinkTiles and open its dedicated Minecraft development world."""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parents[1]
PLAY = ROOT / ".lake/play"
WORLD = PLAY / "saves/LinkTiles"


def build_pack():
    subprocess.run(["lake", "build", "link-tiles"], cwd=ROOT, check=True)
    trace = ROOT / ".lake/build/bin/link-tiles.trace"
    fingerprint = hashlib.sha256(trace.read_bytes()).hexdigest()
    stamp = PLAY / "pack-build.json"
    cached = PLAY / "link-tiles.zip"
    if (
        not cached.exists()
        or not stamp.exists()
        or json.loads(stamp.read_text())["trace"] != fingerprint
    ):
        with tempfile.TemporaryDirectory(prefix="play-build.", dir=ROOT / ".lake") as temporary:
            pack = Path(temporary) / "pack"
            subprocess.run(
                ["lake", "env", ".lake/build/bin/link-tiles", str(pack)],
                cwd=ROOT, check=True,
            )
            archive = Path(temporary) / "link-tiles.zip"
            with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as output:
                for path in sorted(pack.rglob("*")):
                    if path.is_file():
                        output.write(path, path.relative_to(pack))
            archive.replace(cached)
        stamp.write_text(json.dumps({"trace": fingerprint}) + "\n")
    (WORLD / "datapacks").mkdir(parents=True, exist_ok=True)
    shutil.copy2(cached, WORLD / "datapacks/link-tiles.zip")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--prepare-only", action="store_true", help="build and install without opening the client"
    )
    parser.add_argument("--smoke", action="store_true", help="verify a visible client, save a screenshot, and exit")
    parser.add_argument("--online", action="store_true", help="allow Gradle to download dependencies")
    args = parser.parse_args()
    PLAY.mkdir(parents=True, exist_ok=True)
    with (PLAY / ".launch.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            parser.exit(1, "LinkTiles is already running; close the client before relaunching.\n")
        session = WORLD / "session.lock"
        if session.exists():
            with session.open("rb") as stream:
                try:
                    fcntl.lockf(stream, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except BlockingIOError:
                    parser.exit(1, "The LinkTiles world is open; close it before updating its datapack.\n")
                fcntl.lockf(stream, fcntl.LOCK_UN)
        build_pack()
        options = PLAY / "options.txt"
        lines = options.read_text().splitlines() if options.exists() else []
        settings = {
            "onboardAccessibility": "false", "bobView": "false", "enableVsync": "false",
            "pauseOnLostFocus": "false", "maxFps": "60", "renderDistance": "5",
            "simulationDistance": "5", "tutorialStep": "none", "guiScale": "2",
        }
        options.write_text(
            "\n".join(
                [line for line in lines if line.split(":", 1)[0] not in settings]
                + [f"{key}:{value}" for key, value in settings.items()]
            ) + "\n"
        )
        java_home = Path(os.environ.get(
            "LINK_TILES_JAVA_HOME", os.environ.get("JAVA_HOME", "/opt/homebrew/opt/openjdk@25")
        ))
        command = [
            str(java_home / "bin/java"), f"-Dorg.gradle.java.home={java_home}", "-classpath",
            str(ROOT / "play-client/gradle/wrapper/gradle-wrapper.jar"),
            "org.gradle.wrapper.GradleWrapperMain", "-p", str(ROOT / "play-client"), "--console=plain",
        ]
        if not args.online:
            command.append("--offline")
        command.append("classes" if args.prepare_only else "runClient")
        if args.smoke:
            command.append("-PplaySmoke")
        print(
            "Preparing LinkTiles" if args.prepare_only
            else "Opening LinkTiles: aim down and right-click matching tiles",
            flush=True,
        )
        status = PLAY / "play-status.json"
        if not args.prepare_only:
            status.unlink(missing_ok=True)
        with (PLAY / "launcher.log").open("w") as log:
            result = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
        if result.returncode:
            print("\n".join((PLAY / "launcher.log").read_text().splitlines()[-60:]))
            raise SystemExit(result.returncode)
        if args.smoke and not args.prepare_only:
            report = json.loads(status.read_text())
            if report["status"] != "passed":
                raise RuntimeError(f"Client smoke failed: {report}")
            screenshot = PLAY / "screenshots/link-tiles.png"
            if not screenshot.exists():
                raise RuntimeError("The client did not save its screenshot")
            print("Client ready; screenshot:", screenshot)
        else:
            print("Play directory:", PLAY)


if __name__ == "__main__":
    main()
